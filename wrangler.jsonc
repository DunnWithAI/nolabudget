{
  // Static site: site/build.py writes dist/, Cloudflare serves it as-is.
  "name": "nolabudget",
  "account_id": "9870313bd43c2ff6bba4ebb61edbf2df",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "nolabudget.dunn.us", "custom_domain": true }
  ],
  // Lets Cloudflare build a preview copy for every pull request (`wrangler preview`).
  "previews": {}
}
